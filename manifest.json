{
  "manifest_version": 3,
  "name": "__MSG_ext_name__",
  "short_name": "OpenFullShot",
  "version": "1.0.0",
  "default_locale": "en",
  "description": "__MSG_ext_description__",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "__MSG_action_title__"
  },
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "offscreen",
    "contextMenus",
    "downloads",
    "clipboardWrite"
  ],
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+P" },
      "description": "__MSG_cmd_default__"
    },
    "capture-fullpage": {
      "suggested_key": { "default": "Alt+Shift+F" },
      "description": "__MSG_cmd_fullpage__"
    },
    "capture-visible": {
      "suggested_key": { "default": "Alt+Shift+V" },
      "description": "__MSG_cmd_visible__"
    },
    "capture-region": {
      "suggested_key": { "default": "Alt+Shift+R" },
      "description": "__MSG_cmd_region__"
    },
    "copy-fullpage": {
      "description": "__MSG_cmd_copy_fullpage__"
    },
    "copy-region": {
      "description": "__MSG_cmd_copy_region__"
    }
  }
}
